{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsi:expectations:v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "profile_version",
    "fixture_set_digest",
    "expectations"
  ],
  "properties": {
    "schema": {
      "const": "rsi-expectations.v0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "fixture_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "prediction"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "prediction": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  }
}
